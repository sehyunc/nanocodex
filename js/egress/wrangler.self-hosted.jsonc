{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-v2-egress",
  "main": "src/egress.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "alias": {
    "node-rsa": "../nanocodex/tools/browser/unsupportedNodeRsa.mjs"
  },
  "workers_dev": false,
  "minify": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "services": [],
  "vars": {
    "ENVIRONMENT": "production",
    "CLIPROXY_CANARY_AGENT_ID": "ee17cbbe-2b4d-89b9-af60-0a548fd9b513",
    "CLIPROXY_RESPONSES_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_CREDENTIALS",
        "class_name": "UserCredentialBroker"
      },
      {
        "name": "AGENT_SUBJECTS",
        "class_name": "AgentSubjectDirectory"
      },
      {
        "name": "SPOTIFY_RATE_LIMITS",
        "class_name": "SpotifyRateLimit"
      },
      {
        "name": "USER_CONNECTORS",
        "class_name": "UserConnectorBroker"
      },
      {
        "name": "MCP_CONNECTIONS",
        "class_name": "McpConnectionDirectory"
      },
      {
        "name": "CHATGPT_EGRESS",
        "class_name": "ChatGptEgress",
        "script_name": "nanocodex-v2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CodexOAuthBroker"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "UserCredentialBroker",
        "AgentSubjectDirectory"
      ]
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "CodexOAuthBroker"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "UserConnectorBroker"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "McpConnectionDirectory"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "SpotifyRateLimit"
      ]
    }
  ]
}
